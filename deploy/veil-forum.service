[Unit]
Description=veil-forum experimental Tor/I2P forum
After=network.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=veil-forum
Group=veil-forum
WorkingDirectory=/var/lib/veil-forum
# The application listens on loopback and the Tor/I2P gateway terminates TLS.
# Always mark session cookies Secure in the production service, even though
# the application itself is not the TLS listener.
Environment=VEIL_SESSION_COOKIE_SECURE=1
# The database is reached over the local Unix socket with peer authentication,
# so the role name matches this user and no password is stored here.
ExecStart=/usr/local/bin/veil-forum --addr 127.0.0.1:8001 --database-url postgres://veil-forum@%2Fvar%2Frun%2Fpostgresql/veil_forum
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# ProtectProc/ProcSubset require systemd 247+. Omit these two lines only on
# older systemd versions; the remaining restrictions are intentionally kept.
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
